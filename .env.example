# ── The app ─────────────────────────────────────────────────────────────
APP_NAME=iws-clinic-api
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# This API keeps no sessions, cache or queues of its own.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# ── Your clinic database (read only) ────────────────────────────────────
# pgsql, mysql, mariadb or sqlsrv. Use a login that can only SELECT.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simrs
DB_USERNAME=iws_reader
DB_PASSWORD=
# PostgreSQL only: the schema your tables are in.
DB_SEARCH_PATH=public

# The time zone your database writes times in when a column has no zone.
DB_TIMEZONE=Asia/Jakarta

# ── What iws uses ───────────────────────────────────────────────────────
# Bearer keys iws may call with, comma-separated. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Two keys at once let you rotate without downtime. Empty = every call refused.
IWS_API_KEYS=change-me-generate-a-long-random-key

# Optional: iws's IP addresses, comma-separated. Empty = any address (the key still applies).
IWS_ALLOWED_IPS=

# The widest window one request may ask for, in days.
IWS_MAX_WINDOW_DAYS=31

# Behind a load balancer or reverse proxy? Put its address here so the
# allow-list sees iws's real IP, not the proxy's.
TRUSTED_PROXIES=
